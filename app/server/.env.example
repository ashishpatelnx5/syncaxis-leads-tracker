# Copy this file to .env and adjust for your environment.

PORT=4000

# SQL Server connection.
# DB_SERVER can be a plain host ("localhost") or a named instance
# ("SYNCAXIS-SERVER\SQLEXPRESS") - see db/production/README.md for the
# named-instance connectivity prerequisites (TCP/IP, SQL Browser, firewall).
DB_SERVER=SYNCAXIS-SERVER\SQLEXPRESS
DB_PORT=1433
DB_NAME=SYNCAXIS_LEADS
DB_USER=syncaxis_leads_app
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Base URL of syncaxis-iam. This app has no login credentials of its own -
# sign-in and access control are entirely delegated to syncaxis-iam's own
# accounts and permission matrix (grant leads.* permission keys - see
# leads-integration-instructions.md / implement-fine-grained-permissions-
# instructions.md for the full key list).
IAM_API_URL=http://localhost:8054

# Folder where lead attachments (files uploaded from the Lead Detail page) are
# stored, organized as <dir>/leads/<leadId>/<file>. Point this at any path on
# the server - e.g. a data drive - so it survives app rebuilds/redeploys.
# Leave blank to default to app/server/uploads (fine for local development).
UPLOADS_DIR=F:\SyncaxisAppFiles\SyncaxisLeadsApp
