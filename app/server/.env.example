# Copy this file to .env and adjust for your environment.

PORT=4000

# SQL Server connection.
# DB_SERVER can be a plain host ("localhost") or a named instance
# ("SYNCAXIS-SERVER\SQLEXPRESS") - see db/production/README.md for the
# named-instance connectivity prerequisites (TCP/IP, SQL Browser, firewall).
DB_SERVER=SYNCAXIS-SERVER\SQLEXPRESS
DB_PORT=1433
DB_NAME=SYNCAXIS_LEADS
DB_USER=syncaxis_leads_app
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Single shared login for the whole team (not per-user accounts).
AUTH_USERNAME=syncaxis
AUTH_PASSWORD=change-me
# Optional: set this to a fixed random string so logged-in sessions survive an
# app restart. If left blank, a random secret is generated at startup and
# everyone is signed out whenever the process restarts.
SESSION_SECRET=
